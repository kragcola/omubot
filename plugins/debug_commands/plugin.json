{
  "manifest_version": 3,
  "name": "debug_commands",
  "display_name": {
    "zh": "调试指令",
    "en": "Debug Commands"
  },
  "description": "调试与运维指令：运行态检查、权限、插件与版本信息",
  "version": "1.4.0",
  "priority": 300,
  "tier": "user",
  "toggle_policy": "restart_required",
  "category": "ops",
  "permissions": [
    "command"
  ],
  "capabilities": [
    "debug_commands",
    "runtime_debug",
    "authority_admin"
  ],
  "min_omubot_version": "",
  "config": {
    "defaults": "config.default.json",
    "schema": "config.schema.json",
    "apply_mode": "restart_required",
    "restart_required_fields": [
      "plugins_command_enabled",
      "version_command_enabled",
      "max_reply_chars",
      "check_github_updates"
    ]
  },
  "store": {
    "visibility": "local",
    "marketplace_id": ""
  },
  "author": "Omubot"
}
