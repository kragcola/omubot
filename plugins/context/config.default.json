{
  "schema_version": 1,
  "plugin": "context",
  "values": {
    "enabled": true,
    "takeover_dynamic_prompt": true,
    "max_hits": 5,
    "max_doc_hits": 3,
    "max_chars": 2400,
    "graph_auto_extract": true,
    "rrf_k": 60,
    "rrf_weights": {
      "doc": 0.5,
      "memory": 0.3,
      "graph": 0.2
    },
    "use_token_budget": true,
    "budget": {
      "total_tokens": 6000,
      "memory_tokens": 1500,
      "doc_tokens": 2500,
      "graph_tokens": 1700,
      "buffer_tokens": 300
    },
    "temporal_trace": {
      "enabled": true,
      "max_heads": 24,
      "max_kps": 2,
      "max_depth": 4,
      "max_chars": 600
    },
    "query_aware_plan": {
      "enabled": true
    },
    "card_eligibility": {
      "enabled": true,
      "status_ttl_days": 30,
      "event_ttl_days": 180
    },
    "pack_evidence_gate": {
      "enabled": true,
      "memory_soft_confidence": 0.45,
      "graph_soft_confidence": 0.60
    },
    "evidence_use_contract": {
      "enabled": true,
      "inject_constrained_instruction": true
    }
  }
}
