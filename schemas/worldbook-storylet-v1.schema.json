{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omubot.local/schemas/worldbook-storylet-v1.schema.json",
  "title": "Omubot Worldbook Storylet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storylets"],
  "properties": {
    "schema_version": {"const": 1},
    "storylets": {
      "type": "array",
      "items": {"$ref": "#/$defs/storylet"}
    }
  },
  "$defs": {
    "typedEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variable_deltas": {
          "type": "object",
          "additionalProperties": true
        },
        "open_threads": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "resolve_threads": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "stage": {"type": "string", "minLength": 1},
        "partner_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id"],
            "properties": {
              "entity_id": {"type": "string", "minLength": 1},
              "mood": {"type": "string"},
              "availability": {"type": "string"},
              "current_state": {"type": "string"},
              "constraints": {
                "type": "array",
                "items": {"type": "string"}
              },
              "note": {"type": "string"},
              "event_note": {"type": "string"}
            }
          }
        },
        "life_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {},
              "ttl_hours": {"type": "number", "exclusiveMinimum": 0},
              "ttl_seconds": {"type": "number", "exclusiveMinimum": 0}
            },
            "anyOf": [
              {"required": ["ttl_hours"]},
              {"required": ["ttl_seconds"]}
            ]
          }
        }
      }
    },
    "storylet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storylet_id", "title", "text", "scope", "target_arc_id"],
      "properties": {
        "storylet_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "conditions": {"type": "object", "default": {}},
        "saliency": {"type": "number", "minimum": 0, "maximum": 10, "default": 1},
        "severity": {
          "enum": ["daily", "tension", "setback", "major", "crisis", "recovery"],
          "default": "daily"
        },
        "once": {"type": "boolean", "default": false},
        "cooldown_steps": {"type": "integer", "minimum": 0, "default": 0},
        "delay_steps": {"type": "integer", "minimum": 0, "default": 0},
        "cost": {"$ref": "#/$defs/typedEffects", "default": {}},
        "consequence": {"$ref": "#/$defs/typedEffects", "default": {}},
        "recovery_steps": {"type": "integer", "minimum": 0, "default": 0},
        "required_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "scope": {"const": "fiction"},
        "priority": {"type": "integer", "default": 100},
        "target_arc_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
          "minLength": 1
        }
      }
    }
  }
}
